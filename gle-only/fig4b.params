# Parameters reproducing the theory curve of Fig. 4b,
# Snoeijer & Andreotti, Annu. Rev. Fluid Mech. 45 (2013).
#
# Receding plate withdrawn from a silicone-oil bath (Delon et al. 2008):
# lengths in units of the capillary length l_gamma; slip of order two
# molecular sizes; microscopic angle = receding equilibrium angle.
# theta_mic_deg is set so that the static limit Delta(Ca->0) =
# sqrt(2(1 - sin(theta_e))) matches the digitized curve foot (z ~ 0.627).

geometry = vertical
theta_mic_deg = 53.0
slip = 1.0e-6
mu_r = 0.0
grav = 1.0

H_match = 5.0
smax_cap = 100.0
rtol = 1.0e-10
atol = 1.0e-12

Ca_start = 1.0e-6
Delta_max = 3.7
Ca_stop_min = 1.0e-4
max_points = 2000
verbose = 1
