{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/comphy-lab/Contact-line-subgrid-modeling/gle-ode/reference-generator/table.schema.json",
  "title": "Constant-slip two-phase inner-Stokes Q table row",
  "description": "CSV rows are represented as JSON objects for validation. Q is the interpolated runtime quantity.",
  "type": "object",
  "required": [
    "theta_rad",
    "theta_deg",
    "viscosity_ratio",
    "log10_viscosity_ratio",
    "Q",
    "log_c",
    "c",
    "force_intercept",
    "slope_expected",
    "slope_fitted",
    "slope_relative_error",
    "plateau_half_drift_Q",
    "mesh_delta_Q",
    "inner_radius_delta_Q",
    "outer_radius_delta_Q",
    "fit_window_delta_Q",
    "estimated_error_Q",
    "max_linear_system_backward_error",
    "max_constraint_relative_error",
    "converged",
    "generator_version",
    "generator_source_sha256"
  ],
  "properties": {
    "theta_rad": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 3.141592653589793},
    "theta_deg": {"type": "number", "minimum": 3, "maximum": 177},
    "viscosity_ratio": {"type": "number", "exclusiveMinimum": 0},
    "log10_viscosity_ratio": {"type": "number"},
    "Q": {"type": "number", "description": "Canonical additive matching constant; interpolate this column."},
    "log_c": {"type": "number", "description": "1 + log(sin(theta)) - Q; diagnostic only."},
    "c": {"type": "number", "exclusiveMinimum": 0, "description": "exp(log_c); diagnostic only."},
    "force_intercept": {"type": "number"},
    "slope_expected": {"type": "number", "exclusiveMinimum": 0},
    "slope_fitted": {"type": "number"},
    "slope_relative_error": {"type": "number", "minimum": 0},
    "plateau_standard_deviation": {"type": "number", "minimum": 0},
    "plateau_half_drift": {"type": "number", "minimum": 0},
    "plateau_half_drift_Q": {"type": "number", "minimum": 0},
    "mesh_delta_Q": {"type": "number", "minimum": 0},
    "inner_radius_delta_Q": {"type": "number", "minimum": 0},
    "outer_radius_delta_Q": {"type": "number", "minimum": 0},
    "fit_window_delta_Q": {"type": "number", "minimum": 0},
    "estimated_error_Q": {"type": "number", "minimum": 0},
    "linear_system_backward_error": {"type": "number", "minimum": 0},
    "constraint_relative_error": {"type": "number", "minimum": 0},
    "max_linear_system_backward_error": {"type": "number", "minimum": 0},
    "max_constraint_relative_error": {"type": "number", "minimum": 0},
    "fit_lower": {"type": "number", "exclusiveMinimum": 1},
    "fit_upper": {"type": "number"},
    "inner_radius": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "outer_radius": {"type": "number", "exclusiveMinimum": 1},
    "radial_cells": {"type": "integer", "minimum": 8},
    "angular_cells_a": {"type": "integer", "minimum": 2},
    "angular_cells_b": {"type": "integer", "minimum": 2},
    "velocity_dofs": {"type": "integer", "minimum": 1},
    "pressure_dofs": {"type": "integer", "minimum": 1},
    "interface_constraints": {"type": "integer", "minimum": 1},
    "converged": {"const": true},
    "generator_version": {"type": "string", "const": "2"},
    "generator_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
