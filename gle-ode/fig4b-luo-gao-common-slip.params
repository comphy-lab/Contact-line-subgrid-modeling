# Fixed-input comparison: direct Luo--Gao slippery-wedge GLE.
#
# This file and fig4b-chan-common-slip.params use the identical physical slip
# length 7.46e-6. Neither branch is re-fitted in this comparison, so the
# difference isolates model form for this shared input. The value itself is
# the historical fitted length from fig4b.params, not an independent Navier-
# length measurement. The direct model contains no case-level c_slip.

geometry = vertical
gle_model = luo_gao
c_method = auto
theta_mic_deg = 53.46
slip = 7.46e-6
mu_r = 0.0
grav = 1.0

H_match = 5.0
smax_cap = 100.0
rtol = 1.0e-10
atol = 1.0e-12

Ca_start = 1.0e-6
Delta_max = 3.7
Ca_stop_min = 1.0e-4
max_points = 2000
verbose = 1
