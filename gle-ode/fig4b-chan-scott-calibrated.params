# Fig. 4b with the Chan et al. GLE and the Scott/Hocking M=0 closure.
#
# theta_e is fixed by the static foot, exactly as in fig4b.params. The slip
# length is then independently calibrated to the legacy continuation fold
# Ca* = 1.0544249173e-2. This makes fold agreement circular: the fold height
# and the rest of the branch are the out-of-sample comparisons.
#
# A one-dimensional secant solve in slip, evaluated with
#   mesh_N=2500 dDelta=0.002 dDelta_max=0.015 Delta_max=1.8
# gives slip = 8.8078e-6 and fold Ca* = 1.0544241743e-2. Preserving only
# c_slip*slip does not give the same branch because the default inner start is
# s0=slip.

geometry = vertical
gle_model = chan
c_method = scott_hocking
theta_mic_deg = 53.46
slip = 8.8078e-6
mu_r = 0.0
grav = 1.0

H_match = 5.0
smax_cap = 100.0
rtol = 1.0e-10
atol = 1.0e-12

Ca_start = 1.0e-6
Delta_max = 3.7
Ca_stop_min = 1.0e-4
max_points = 2000
verbose = 1
